# Copy to Portainer stack env as "stack.env" OR paste keys in the Stack UI
# "Environment variables" editor. Never commit real secrets.

# Host publish port (CAMT): 11401–11499 only. Must match Portainer HOST_PORT.
HOST_PORT=11421

# --- Database (use Postgres CONTAINER name as host, not 127.0.0.1) ---
DATABASE_URL=postgresql+psycopg2://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_CONTAINER_NAME:5432/DB_NAME

SECRET_KEY=change-me-long-random
SEED_USERNAME=admin
SEED_PASSWORD=change-me
SEED_EMAIL=admin@example.com

# --- LLM (cloud — do not run Ollama on this 8GB host) ---
CLOUD_API_KEY=your_openrouter_or_groq_key
AGENT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- MCP (Feature 2) ---
MCP_HTTP_ENABLED=true
MCP_API_TOKENS=pick-a-long-random-token
MCP_LINE_BOT_TOKEN=pick-a-long-random-token
MCP_INTERNAL_MODE=http
MCP_RATE_LIMIT_PER_MINUTE=60
# Include the public hostname LINE / browsers will use:
# Include host:114xx if you hit the API by IP:port (swap 11421 for your HOST_PORT)
MCP_ALLOWED_HOSTS=localhost,localhost:11421,127.0.0.1,127.0.0.1:11421,dev2.camt.cmu.ac.th

# --- Admin LINE (Feature 4) ---
ADMIN_LINE_CHANNEL_SECRET=
ADMIN_LINE_ACCESS_TOKEN=
ADMIN_LINE_LINK_SECRET=change-me-long-random-link-secret
ADMIN_PUSH_ALERT_TYPES=device_offline

# --- User LINE (Feature 6) ---
USER_LINE_CHANNEL_SECRET=
USER_LINE_ACCESS_TOKEN=

# --- Email & weekly reports (Feature 5) ---
# Weekly CSV/PDF reports are emailed to every approved admin.
# Set EMAIL_DISABLED=false ONLY after SMTP_* point at a real relay.
# Standard providers (Gmail app password, SendGrid, SES, Mailgun) work with
# SMTP_USER + SMTP_PASSWORD over STARTTLS on port 587.
EMAIL_DISABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parkpilot@camt.cmu.ac.th
SMTP_TIMEOUT=15
# Send time is container-local. This image has no tzdata, so it defaults to UTC:
# WEEKLY_REPORT_HOUR=8 means 08:00 UTC (15:00 Thailand). Adjust accordingly.
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=8
WEEKLY_REPORT_MINUTE=0

# --- Anomaly thresholds ---
ANOMALY_SCAN_INTERVAL_MINUTES=5
ANOMALY_STUCK_SLOT_HOURS=12
ANOMALY_PIPELINE_INACTIVE_MINUTES=15
ANOMALY_DEVICE_OFFLINE_SECONDS=300

# --- Optional: MQTT / S3 / Google — fill only if you use those features ---
# MQTT_BROKER_HOST=
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_TOPIC=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://dev2.camt.cmu.ac.th/api/oauth/google/callback
# FRONTEND_URL=https://your-frontend
