# Postgres container
POSTGRES_USER="POSTGRES_USER"
POSTGRES_PASSWORD="POSTGRES_PASSWORD"
POSTGRES_DB="DB_NAME"
DATABASE_URL="<DB_TYPE>+<DB_DIALECT>://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<DB_SERVER>:<PORT>/<DB_NAME>"

# Set to "false" in production: echoing every SQL statement is noisy and slow.
# The stdio MCP server forces this off because it writes JSON-RPC on stdout.
SQL_ECHO="true"

SECRET_KEY="APP_SECRET"
SEED_USERNAME="ADMIN_NAME"
SEED_PASSWORD="ADMIN_PASSWORD"
SEED_EMAIL="ADMIN_EMAIL"

# MQTT configuration
MQTT_BROKER_HOST="HIVEMQTT_HOST"
MQTT_USER="HIVEMQTT_USER"
MQTT_PASSWORD="HIVEMQTT_PASSWORD"
MQTT_TOPIC="TOPIC_TO_SUB"

# Content Storage
DRIVE_FOLDER_ID="Optional_DRIVE_ID"
S3_BUCKET="IMAGE_S3"
S3_REGION="BUCKET_REGION"
CLOUDFRONT_URL="CLOUDFRONT_URL"
AWS_ACCESS_KEY="AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="AWS_SECRET_ACCESS_KEY"

# Google OAuth (Feature 5)
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/oauth/google/callback"
FRONTEND_URL="http://localhost:5173"

# Email & Reporting (Feature 5)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="parkpilot@camt.cmu.ac.th"
LINE_BOT_URL="https://line.me/R/ti/p/@parkpilot"
EMAIL_DISABLED="true"
WEEKLY_REPORT_DAY="mon"
WEEKLY_REPORT_HOUR="8"
WEEKLY_REPORT_MINUTE="0"

# MCP Server (Feature 2)
# Comma-separated bearer tokens allowed to invoke MCP tools over HTTP at /mcp.
# Leave empty to reject every HTTP request; stdio (python -m mcp_server) is unaffected.
MCP_API_TOKENS=""
MCP_HTTP_ENABLED="true"
MCP_RATE_LIMIT_PER_MINUTE="60"
# Hosts allowed in the Host header for /mcp (DNS rebinding protection).
# Must include the CAMT server host on deploy.
# MCP_ALLOWED_HOSTS="localhost,localhost:8000,127.0.0.1,127.0.0.1:8000"

# Anomaly detection thresholds (Feature 2)
ANOMALY_SCAN_INTERVAL_MINUTES="5"
ANOMALY_STUCK_SLOT_HOURS="12"
ANOMALY_PIPELINE_INACTIVE_MINUTES="15"
ANOMALY_DEVICE_OFFLINE_SECONDS="300"

# Feature 4 — Admin LINE bot + notifications (consumes Feature 2 MCP over HTTP)
ADMIN_LINE_CHANNEL_SECRET=""
ADMIN_LINE_ACCESS_TOKEN=""
# Shared secret admins send as: /link <secret>
ADMIN_LINE_LINK_SECRET=""
# Bearer token the admin bot uses at /mcp. Must also appear in MCP_API_TOKENS.
MCP_LINE_BOT_TOKEN=""
MCP_INTERNAL_URL="http://127.0.0.1:8000/mcp/"
# http (production) | inprocess (unit tests / local without HTTP loopback)
MCP_INTERNAL_MODE="http"
# LLM used by the admin (and user) chatbot for tool orchestration
CLOUD_API_KEY=""
AGENT_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
# LINE push allow-list (comma-separated). Default = hardware only, like dashboard.
# Add pipeline_inactive if you also want "no events from lot" alerts.
# Example while campus feed is noisy: device_offline
ADMIN_PUSH_ALERT_TYPES="device_offline"
